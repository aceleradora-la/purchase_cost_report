<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_cost_report_button" model="ir.ui.view">
        <field name="name">purchase.order.form.cost.report</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Botón en la barra de estado del formulario de OC -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_print_cost_report"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    string="Valuación"
                    invisible="state not in ('purchase', 'done')"
                    title="Reporte de valuación en moneda de compra"
                />
            </xpath>
        </field>
    </record>

</odoo>
