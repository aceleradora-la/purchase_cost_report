<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Vista form del wizard ─────────────────────────────────────── -->
    <record id="view_purchase_cost_report_wizard_form" model="ir.ui.view">
        <field name="name">purchase.cost.report.wizard.form</field>
        <field name="model">purchase.cost.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Valuación en Moneda de Compra">

                <!-- Encabezado con datos de la OC -->
                <div class="o_horizontal_separator mb-3">
                    <div class="row align-items-center">
                        <div class="col-5">
                            <field name="order_id" readonly="1" nolabel="1"
                                   options="{'no_open': False}"
                                   class="fs-4 fw-bold text-primary"/>
                        </div>
                        <div class="col-7 text-end">
                            <field name="currency_id" invisible="1"/>
                            <!-- Resumen financiero en línea -->
                            <span class="text-muted me-3">
                                Proveedor:
                                <strong><field name="total_product" readonly="1" nolabel="1" class="d-inline" widget="monetary" options="{'currency_field': 'currency_id'}"/></strong>
                            </span>
                            <span class="text-muted me-3">
                                Destino:
                                <strong><field name="total_lc" readonly="1" nolabel="1" class="d-inline" widget="monetary" options="{'currency_field': 'currency_id'}"/></strong>
                            </span>
                            <span class="text-muted me-3">
                                Total:
                                <strong><field name="total_all" readonly="1" nolabel="1" class="d-inline" widget="monetary" options="{'currency_field': 'currency_id'}"/></strong>
                            </span>
                            <!-- % destacado -->
                            <span class="badge rounded-pill fs-6"
                                  style="background-color:#198754; color:white; padding: 6px 14px;"
                                  invisible="lc_percentage == 0">
                                <field name="lc_percentage" readonly="1" nolabel="1" class="d-inline" widget="float" options="{'digits': [5,2]}"/>%
                                costos de importación
                            </span>
                        </div>
                    </div>
                </div>

                <notebook>

                    <!-- ── Tab 1: Resumen por Producto ──────────────────── -->
                    <page string="Resumen por Producto" name="products">
                        <field name="product_line_ids" readonly="1" nolabel="1">
                            <list
                                decoration-muted="lc_total == 0"
                                string="Productos recibidos">
                                <field name="currency_id" column_invisible="1"/>
                                <field name="product_id" string="Producto"/>
                                <field name="ordered_qty" string="Ord."/>
                                <field name="received_qty" string="Rec."/>
                                <field name="uom_id" string="UdM"/>
                                <field name="product_unit_cost"
                                       string="Costo Unit. Prov."
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="product_total_cost"
                                       string="Total Prov."
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="lc_total"
                                       string="Costos Destino"
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="unit_cost"
                                       string="Costo Unit. Total"
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       class="fw-bold"/>
                                <field name="total_cost"
                                       string="Costo Total"
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       class="fw-bold"/>
                            </list>
                        </field>
                    </page>

                    <!-- ── Tab 2: Resumen Costos en Destino ─────────────── -->
                    <page string="Resumen Costos en Destino" name="lc_summary">
                        <field name="lc_summary_ids" readonly="1" nolabel="1">
                            <list string="Resumen de Costos en Destino">
                                <field name="currency_id" column_invisible="1"/>
                                <field name="ref_currency_id" column_invisible="1"/>
                                <field name="landed_cost_id"
                                       string="Costo en Destino"
                                       options="{'no_create': True}"/>
                                <field name="vendor_bill_id"
                                       string="Factura"
                                       options="{'no_create': True}"/>
                                <field name="date" string="Fecha"/>
                                <field name="amount_ref"
                                       string="Monto Origen"
                                       widget="monetary"
                                       options="{'currency_field': 'ref_currency_id'}"
                                       optional="show"/>
                                <field name="ref_currency_id"
                                       string="Mon. Orig."
                                       optional="show"/>
                                <field name="exchange_rate"
                                       string="Tipo de Cambio"
                                       widget="float"
                                       digits="[16,2]"
                                       optional="show"/>
                                <field name="amount_po"
                                       string="Monto en Moneda OC"
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       class="fw-bold"/>
                            </list>
                        </field>
                        <div class="text-muted mt-2" style="font-size: 12px;">
                            <strong>Tipo de Cambio:</strong>
                            1 unidad de la moneda OC = X unidades de la moneda origen,
                            calculado a la fecha de la factura del costo en destino.
                        </div>
                    </page>

                    <!-- ── Tab 3: Detalle por Producto ───────────────────── -->
                    <page string="Detalle por Producto" name="lc_details">
                        <field name="lc_line_ids" readonly="1" nolabel="1">
                            <list string="Detalle de Costos en Destino">
                                <field name="currency_id" column_invisible="1"/>
                                <field name="ref_currency_id" column_invisible="1"/>
                                <field name="product_id" string="Producto"/>
                                <field name="landed_cost_id"
                                       string="Costo en Destino"
                                       options="{'no_create': True}"/>
                                <field name="vendor_bill_id"
                                       string="Factura"
                                       options="{'no_create': True}"/>
                                <field name="date" string="Fecha"/>
                                <field name="amount_ref"
                                       string="Monto Origen"
                                       widget="monetary"
                                       options="{'currency_field': 'ref_currency_id'}"/>
                                <field name="ref_currency_id"
                                       string="Mon. Orig."
                                       optional="show"/>
                                <field name="amount_po"
                                       string="Monto OC"
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       class="fw-bold"/>
                            </list>
                        </field>
                        <div class="text-muted mt-2" style="font-size: 12px;">
                            Los montos OC se calculan usando el TC de la moneda de la OC
                            a la fecha de la factura del costo en destino.
                        </div>
                    </page>

                    <!-- ── Tab 4: Actualizar Precios de Venta ────────────── -->
                    <page string="Actualizar Precios de Venta" name="pricing">

                        <!-- Controles globales -->
                        <group>
                            <group string="Lista de precios">
                                <field name="pricelist_id"
                                       options="{'no_create': True}"
                                       placeholder="Seleccioná una lista de precios…"/>
                                <field name="price_date_start"/>
                            </group>
                            <group string="Margen global">
                                <field name="margin_percent"
                                       widget="float"
                                       options="{'digits': [5,2]}"
                                       string="Margen de Ganancia (%)"
                                       help="Se aplica a todos los productos. Podés sobreescribirlo por línea."/>
                            </group>
                        </group>

                        <!-- Tabla de líneas de precio -->
                        <field name="pricing_line_ids" nolabel="1">
                            <list editable="bottom" string="Precios por Producto">
                                <field name="currency_id" column_invisible="1"/>
                                <field name="product_id" string="Producto" readonly="1"/>
                                <field name="cost_total"
                                       string="Costo Total"
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       readonly="1"/>
                                <field name="margin_percent"
                                       string="Margen (%)"
                                       widget="float"
                                       options="{'digits': [5,2]}"
                                       help="Dejá en 0 para usar el margen global."/>
                                <field name="suggested_price"
                                       string="Precio Sugerido"
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       readonly="1"/>
                                <field name="final_price"
                                       string="Precio Final"
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       class="fw-bold"/>
                            </list>
                        </field>

                        <div class="text-muted mt-2" style="font-size: 12px;">
                            Si la lista de precios está en otra moneda, el precio final se convierte
                            automáticamente al momento de aplicar.
                            El precio vigente anterior se vence el día antes de la fecha de vigencia indicada.
                        </div>

                    </page>

                </notebook>

                <!-- Botones de acción -->
                <footer>
                    <button name="action_print_pdf"
                            type="object"
                            string="Imprimir PDF"
                            class="btn-primary"
                            icon="fa-print"/>
                    <button name="action_apply_prices"
                            type="object"
                            string="Aplicar Precios"
                            class="btn-success"
                            icon="fa-tag"
                            invisible="not pricelist_id"
                            confirm="¿Aplicar los precios calculados a la lista de precios seleccionada? Los precios vigentes se vencerán el día anterior a la fecha de vigencia indicada."/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>

            </form>
        </field>
    </record>

</odoo>
