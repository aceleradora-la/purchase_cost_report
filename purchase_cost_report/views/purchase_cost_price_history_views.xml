<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Lista de historial ─────────────────────────────────────────── -->
    <record id="view_purchase_cost_price_history_list" model="ir.ui.view">
        <field name="name">purchase.cost.price.history.list</field>
        <field name="model">purchase.cost.price.history</field>
        <field name="arch" type="xml">
            <list string="Historial de Actualizaciones de Precio" create="0" edit="0" delete="0">
                <field name="date_applied" string="Vigencia desde"/>
                <field name="order_id" string="Orden de Compra"/>
                <field name="pricelist_id" string="Lista de Precios" optional="show"/>
                <field name="product_id" string="Producto"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="pricelist_currency_id" column_invisible="1"/>
                <field name="cost_total"
                       string="Costo Total"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="margin_percent" string="Margen (%)"/>
                <field name="final_price"
                       string="Precio Aplicado"
                       widget="monetary"
                       options="{'currency_field': 'pricelist_currency_id'}"
                       class="fw-bold"/>
                <field name="note" string="Detalle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ── Form del historial (solo lectura) ─────────────────────────── -->
    <record id="view_purchase_cost_price_history_form" model="ir.ui.view">
        <field name="name">purchase.cost.price.history.form</field>
        <field name="model">purchase.cost.price.history</field>
        <field name="arch" type="xml">
            <form string="Actualización de Precio" create="0" edit="0">
                <group>
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="order_id" readonly="1"/>
                        <field name="pricelist_id" readonly="1"/>
                        <field name="date_applied" readonly="1"/>
                    </group>
                    <group>
                        <field name="currency_id" readonly="1"/>
                        <field name="cost_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="margin_percent" readonly="1"/>
                        <field name="pricelist_currency_id" readonly="1"/>
                        <field name="final_price" readonly="1" widget="monetary" options="{'currency_field': 'pricelist_currency_id'}"/>
                    </group>
                </group>
                <group string="Detalle del cálculo">
                    <field name="note" readonly="1" nolabel="1" colspan="2"/>
                </group>
            </form>
        </field>
    </record>

    <!-- ── Acción ─────────────────────────────────────────────────────── -->
    <record id="action_purchase_cost_price_history" model="ir.actions.act_window">
        <field name="name">Historial de Actualizaciones de Precio</field>
        <field name="res_model">purchase.cost.price.history</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ── Menú bajo Órdenes de Compra ──────────────────────────────── -->
    <menuitem id="menu_purchase_cost_price_history"
              name="Historial de Precios de Valuación"
              parent="purchase.menu_purchase_order"
              action="action_purchase_cost_price_history"
              sequence="99"/>

</odoo>
