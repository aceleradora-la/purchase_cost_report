<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Lista de ítems de lista de precios con columna de nota de valuación -->
    <record id="product_pricelist_item_tree_cost_note" model="ir.ui.view">
        <field name="name">product.pricelist.item.list.purchase.cost.note</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="purchase_cost_note"
                       string="Origen del precio"
                       optional="show"
                       readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
