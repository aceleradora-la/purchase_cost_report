<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Form del ítem: nota de valuación + botón historial ─────────── -->
    <record id="product_pricelist_item_form_cost_note" model="ir.ui.view">
        <field name="name">product.pricelist.item.form.purchase.cost.note</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//separator[@string='AJUSTES DE LA EMPRESA']" position="before">
                <separator string="Origen del precio" invisible="not purchase_cost_note"/>
                <field name="purchase_cost_note"
                       nolabel="1"
                       readonly="1"
                       invisible="not purchase_cost_note"
                       colspan="2"/>
                <button name="action_open_cost_history"
                        type="object"
                        string="Ver historial completo"
                        icon="fa-history"
                        class="btn-link"
                        invisible="not purchase_cost_note"/>
            </xpath>
        </field>
    </record>

</odoo>
